# Shared database (all microservices use the same MySQL instance)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=workians_lms
# Keep low when running 6 services against a remote DB (Hostinger, etc.)
DB_CONNECTION_LIMIT=2
# Auto-enabled for *.hstgr.io hosts; set true for other remote MySQL
DB_SSL=false
DB_CONNECT_TIMEOUT=20000

JWT_SECRET=your_jwt_secret

# API Gateway (frontend + Vite proxy point here)
GATEWAY_PORT=5000
# Do not reuse PORT for gateway if monolith used PORT=5003 — set GATEWAY_PORT explicitly

# Individual service ports (internal)
IDENTITY_SERVICE_PORT=5001
USER_SERVICE_PORT=5002
COURSE_SERVICE_PORT=5003
COMMUNITY_SERVICE_PORT=5004
CONTENT_SERVICE_PORT=5005
PAYMENT_SERVICE_PORT=5006

# Docker: use service hostnames instead of 127.0.0.1
# IDENTITY_SERVICE_HOST=identity
# USER_SERVICE_HOST=user
# COURSE_SERVICE_HOST=course
# COMMUNITY_SERVICE_HOST=community
# CONTENT_SERVICE_HOST=content
# PAYMENT_SERVICE_HOST=payment
